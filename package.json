{
  "name": "evm-bytecode-analyzer",
  "version": "1.0.0",
  "description": "EVM Bytecode Reverse Engineering Toolkit — Disassembler, CFG Builder, Security Analyzer",
  "main": "dist/index.js",
  "bin": {
    "analyzer": "dist/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "cli": "ts-node src/index.ts",
    "test": "jest --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fastify": "^4.28.0",
    "@fastify/cors": "^9.0.1",
    "viem": "^2.17.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "@types/jest": "^29.5.12"
  }
}